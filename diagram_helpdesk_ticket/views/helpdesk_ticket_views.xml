<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="helpdesk_ticket_form_inherit_draw_io" model="ir.ui.view">
        <field name="name">helpdesk.ticket.form.inherit.draw_io</field>
        <field name="model">helpdesk.ticket</field>
        <field name="inherit_id" ref="helpdesk.helpdesk_ticket_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook//page[last()]" position="after">
                <page name="diagram_page" string="Diagrams">
                    <div class="d-flex align-items-center">
                        <group>
                            <field name="show_load_diagram" invisible="1"/>
                            <field name="diagram_version_id" 
                                   options="{'no_create': True}"/>
                        </group>
                        <div class="ms-3">
                            <button type="object" name="update_show_load_diagram"
                                    class="btn btn-primary load-diagram-version mb-1"
                                    string="Load Version"
                                    invisible="not show_load_diagram"/>
                            <button name="%(base_draw_io.action_diagram_versions)d"
                                    type="action"
                                    context="{'default_reference_model': 'helpdesk.ticket', 'default_reference_id': id, 'search_default_reference_model': 'helpdesk.ticket', 'search_default_reference_id': id}"
                                    string="Manage Versions"
                                    class="btn btn-secondary mb-1"/>
                        </div>
                    </div>
                    <group>
                        <field name="diagram" widget="draw_diagram"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>