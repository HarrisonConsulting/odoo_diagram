<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Form view: -->
    <record id="knowledge_article_view_form" model="ir.ui.view">
        <field name="name">knowledge.article.view.form.inherit.diagram</field>
        <field name="model">knowledge.article</field>
        <field name="inherit_id" ref="knowledge.knowledge_article_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="/form" position="inside">
                <field name="show_load_diagram" invisible="1"/>
                <field name="diagram" invisible="1"/>
                <field name="diagram_version_id" invisible="1"/>
            </xpath>
        </field>
    </record>
    
    <!-- Add action to manage diagram versions -->
    <record id="action_knowledge_diagram_versions" model="ir.actions.act_window">
        <field name="name">Diagram Versions</field>
        <field name="res_model">diagram.version</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('reference_model', '=', 'knowledge.article')]</field>
        <field name="context">{'default_reference_model': 'knowledge.article'}</field>
        <field name="path">knowledge-diagram-versions</field>
    </record>
</odoo>